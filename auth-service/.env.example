# Application
APP_ENV=development
APP_NAME=auth-service
PORT=6969
LOG_LEVEL=debug

# Database
# Note: Using port 5435 to avoid conflicts with other PostgreSQL instances
DATABASE_URL=postgres://authuser:authpass@localhost:5435/authdb?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=5m

# Redis
# Note: Using port 6382 to avoid conflicts with other Redis instances
REDIS_URL=redis://localhost:6382/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2
REDIS_CONN_MAX_IDLE_TIME=5m
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# Cache TTL Configuration
CACHE_SESSION_TTL=15m
CACHE_USER_TTL=5m
CACHE_FAILED_LOGIN_TTL=1h

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_REGISTER_PER_MIN=3
RATE_LIMIT_API_PER_MIN=60

# Tokens
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-min-32-chars-required-here
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-min-32-chars-required-here
PASETO_SYMMETRIC_KEY=your-32-byte-paseto-symmetric-key-exactly-32-chars!
TOKEN_ISSUER=auth-service
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=168h
MAGIC_LINK_DURATION=15m

# SMTP / Email
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@authservice.com
SMTP_FROM_NAME=Auth Service

# Security
BCRYPT_COST=12
ARGON2_MEMORY=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,X-CSRF-Token,X-Tenant-ID
CORS_EXPOSED_HEADERS=Link
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=300



# Multi-tenancy
TENANT_HEADER_NAME=X-Tenant-ID
DEFAULT_TENANT_ID=default

# 2FA / TOTP
TOTP_ISSUER=AuthService
TOTP_PERIOD=30
TOTP_DIGITS=6
TOTP_ALGORITHM=SHA1

# Session
SESSION_COOKIE_NAME=auth_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_MAX_DEVICES=5

# Failed login protection
MAX_FAILED_LOGIN_ATTEMPTS=5
FAILED_LOGIN_BLOCK_DURATION=15m

# Magic Links
MAGIC_LINK_BASE_URL=http://localhost:3000/auth/magic-link
